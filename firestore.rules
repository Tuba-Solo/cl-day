// CL day gap analysis site. This block is ADDED inside the existing
//   match /databases/{database}/documents { ... }
// of the eips-planner-dev rules. It does not change any existing rule.
// Resource ranks block added 2026-10-07.
// Ranks closed 2026-10-09 00:00 UTC (6:00 pm Oct 8, Alberta). Changed 2026-10-09.
// Grades 8 and 9 added 2026-11-23. Their sessions (cl-2026-gr8, cl-2026-gr9) use this same block. A ratings document's
// table field is the table letter in Grade 7 and the grade ('8' or '9') in Grades 8 and 9, which have no tables.
// Gap analysis (all three grades) open to 2027-01-01 07:00 UTC (end of Dec 31, 2026, Alberta). To change the closing
// date, edit the date in cdOpen() only: timestamp.date(year, month, day) is midnight UTC, and + 7h makes it midnight in Alberta (MST).

    // ---- CL day gap analysis (added 2026-10-06) ----
    match /clDaySessions/{sid} {
      function cdOpen() { return request.time < timestamp.date(2027, 1, 1) + duration.value(7, 'h'); }  // gap analysis, all grades: open to end of Dec 31, 2026 in Alberta (MST)
      function cdRankOpen() { return request.time < timestamp.date(2026, 10, 9); }  // resource developer priorities: closed 6 pm Oct 8
      function cdTable(t) { return t in ['A', 'B', 'C', 'D', 'E', '8', '9']; }  // Grade 7 table letters, or the grade for Grades 8 and 9
      function cdGrades(g) {
        return g is map && g.keys().hasOnly(['g7', 'g8', 'g9'])
          && g.g7 is int && g.g8 is int && g.g9 is int
          && g.g7 >= 0 && g.g8 >= 0 && g.g9 >= 0
          && g.g7 + g.g8 + g.g9 <= 100;
      }
      function cdBriefKeys() { return ['table', 'createdAt', 'updatedAt', 'code', 'content', 'know', 'fits', 'watch', 'sources']; }

      match /ratings/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && cdOpen()
          && request.auth.uid == uid
          && cdTable(request.resource.data.table)
          && request.resource.data.keys().hasOnly(['table', 'updatedAt', 'r']);
      }
      match /tables/{t} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && cdOpen() && cdTable(t)
          && request.resource.data.keys().hasOnly(['v', 'disagreed', 'updatedAt']);
      }
      match /briefs/{id} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && cdOpen()
          && cdTable(request.resource.data.table)
          && request.resource.data.keys().hasOnly(cdBriefKeys());
        allow update: if request.auth != null && cdOpen()
          && request.resource.data.table == resource.data.table
          && request.resource.data.keys().hasOnly(cdBriefKeys());
      }
      match /ranks/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && cdRankOpen()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['order', 'other', 'grades', 'when', 'updatedAt'])
          && (!('order' in request.resource.data) || (request.resource.data.order is list && request.resource.data.order.size() <= 6))
          && (!('other' in request.resource.data) || request.resource.data.other.size() <= 1000)
          && (!('grades' in request.resource.data) || cdGrades(request.resource.data.grades))
          && (!('when' in request.resource.data) || request.resource.data.when in ['s2-2627', 's1-2728']);
      }
    }
    // ---- end CL day block ----
